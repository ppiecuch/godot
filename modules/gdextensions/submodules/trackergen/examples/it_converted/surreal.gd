# Procedural instruments cycle through musical presets (one per IT slot).
const PRESETS := ["saw_lead", "square_lead", "pluck", "reese_bass", "fm_epiano", "organ", "pad", "fm_bell"]

func build_song() -> TrackerSong:
	var kit := TrackerKit.new()
	var insts := []
	for i in range(NUM_INST):
		var it := TrackerInstrument.new()
		it.load_preset(PRESETS[i % PRESETS.size()])
		insts.append(it)
	kit.instruments = insts
	var song := TrackerSong.new()
	song.kit = kit
	song.tempo_bpm = TEMPO_BPM
	song.steps_per_beat = STEPS_PER_BEAT
	song.beats_per_bar = 4
	var pats := []
	for pi in range(PAT_EVENTS.size()):
		var p := TrackerPattern.new()
		p.set_steps(int(PAT_STEPS[pi]))
		var e : PoolIntArray = PAT_EVENTS[pi]
		var i := 0
		while i < e.size():
			var midi : int = e[i + 2]
			if midi < 0:
				p.add_event({"step": e[i], "lane": e[i + 1], "type": TrackerPattern.NOTE_OFF, "index": 0, "octave": 0, "instrument": 0, "volume": 0.0})
			else:
				p.add_event({"step": e[i], "lane": e[i + 1], "type": TrackerPattern.NOTE_ABSOLUTE, "index": midi, "octave": 0, "instrument": e[i + 3], "volume": float(e[i + 4]) / 64.0})
			i += 5
		pats.append(p)
	song.patterns = pats
	song.order = ORDER
	return song

func _ready() -> void:
	var s := AudioStreamTracker.new()
	s.song = build_song()
	s.voices = 16
	var pl := AudioStreamPlayer.new()
	add_child(pl)
	pl.stream = s
	pl.play()
