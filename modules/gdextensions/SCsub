def is_enabled(m):
    mod = os.path.dirname(m) if os.path.dirname(m) else m
    if "gdext_enable_submodules" in env:
        if "none" in env["gdext_enable_submodules"]:
            return False
        if mod in env["gdext_enable_submodules"]:
            return True
        # check for group name only
        el = [x for x in env["gdext_enable_submodules"] if x.startswith(m)]
        return len(el) > 0
    return True


def secret(path):
    with open(path, "r") as infile:
        return infile.read(8) == "U2FsdGVk"
    return False


