                    if os.path.getmtime(os.path.join(_ms_src, fn)) > _ms_cpp_mtime:
                        _ms_need_regen = True
                        break
            if not _ms_need_regen:
                _cp_dir = os.path.join(_ms_src, "codepoints")
                if os.path.isdir(_cp_dir):
                    for fn in os.listdir(_cp_dir):
                        if os.path.getmtime(os.path.join(_cp_dir, fn)) > _ms_cpp_mtime:
                            _ms_need_regen = True
                            break
        if _ms_need_regen:
            print("(GDextensions) Generating material_symbols_data.gen.{h,cpp} ...")
            subprocess.check_call([
                sys.executable, _ms_script,
                "--src", _ms_src,
                "--out-h", _ms_gen_h,
                "--out-cpp", _ms_gen_cpp,
            ])
        sources += [os.path.join(_ms_dir, "material_symbols_data.gen.cpp")]
        if env["builtin_freetype"]:
            env_module.Prepend(CPPPATH=["#thirdparty/freetype/include"])
    else:
        _ms_manifest = env["gdext_material_symbols_subset"]
        if _ms_manifest and os.path.isfile(_ms_manifest):
            # Skip the tools-only sources from auto-glob.
            ignore += [
                os.path.join(_ms_dir, "material_symbols.cpp"),
                os.path.join(_ms_dir, "material_symbols_renderer.cpp"),
                os.path.join(_ms_dir, "material_symbols_resources.c"),
                os.path.join(_ms_dir, "material_symbols_data.gen.cpp"),
            ]
            import subprocess

            _ms_baked_cpp = os.path.join(_ms_dir, "material_symbols_baked.gen.cpp")
            _ms_bake_script = os.path.join(_ms_dir, "bake_material_symbols.py")
            _ms_need_bake = (
                not os.path.exists(_ms_baked_cpp)
                or os.path.getmtime(_ms_manifest) > os.path.getmtime(_ms_baked_cpp)
            )
            if _ms_need_bake:
                # Best-effort editor-binary discovery. The app's bin/build_*.sh
                # is expected to set GDEXT_BAKE_EDITOR; fall back to a few
                # sibling-directory candidates produced by build_osx.sh.
                _ms_editor = os.environ.get("GDEXT_BAKE_EDITOR", "")
                if not _ms_editor:
                    for _cand in [
                        os.path.join("bin", "godot.osx.opt.tools.arm64"),
                        os.path.join("bin", "godot.osx.opt.tools.64"),
                        os.path.join("bin", "godot.osx.tools.arm64"),
                    ]:
                        if os.path.isfile(_cand) and os.access(_cand, os.X_OK):
                            _ms_editor = _cand
                            break
                if not _ms_editor:
                    print("(GDextensions) material_symbols: cannot find editor binary for "
                          "baking. Set GDEXT_BAKE_EDITOR=/path/to/godot.tools or run a "
                          "tools build first.")
                    modules.remove("material_symbols")
                else:
                    print("(GDextensions) Baking material_symbols from %s ..." % _ms_manifest)
                    subprocess.check_call([
                        sys.executable, _ms_bake_script,
                        "--manifest", _ms_manifest,
                        "--editor", _ms_editor,
                        "--out-cpp", _ms_baked_cpp,
                    ])
            if "material_symbols" in modules:
                sources += [_ms_baked_cpp]
        else:
            print("(GDextensions) material_symbols: no gdext_material_symbols_subset set "
                  "and target is non-tools — module disabled.")
            modules.remove("material_symbols")

