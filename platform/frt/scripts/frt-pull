#! /bin/sh
set -e

# frt-pull
#
# FRT - A Godot platform targeting single board computers
# Copyright (c) 2017-2025  Emanuele Fornara
# SPDX-License-Identifier: MIT
#

# Detect if FRT is already part of the Godot tree
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
GODOT_ROOT="$(cd "${SCRIPT_DIR}/../../.." 2>/dev/null && pwd)"
if [ -f "${GODOT_ROOT}/platform/frt/README.md" ]; then
	echo "FRT is already embedded in the Godot tree at: ${GODOT_ROOT}"
	echo "No need to clone — skipping."
	exit 0
fi

if [ -d godot3 ]
then
	cd godot3
	git pull
	cd ..
else
	git clone -b frt https://github.com/efornara/godot3
fi

cd godot3/platform
if [ -d frt ]
then
	cd frt
	git pull
	cd ..
else
	git clone https://github.com/efornara/frt
fi
