#! /bin/sh
set -e

# frt-compile
#
# FRT - A Godot platform targeting single board computers
# Copyright (c) 2017-2025  Emanuele Fornara
# SPDX-License-Identifier: MIT
#

# Determine Godot root from script location
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
GODOT_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"

if [ ! -f "${GODOT_ROOT}/platform/frt/scripts/basic_compile.sh" ]
then
	echo
	echo "File ${GODOT_ROOT}/platform/frt/scripts/basic_compile.sh does not exist!"
	echo
	echo "Have you cloned the repository with frt-pull?"
	echo "Are you in the right directory?"
	echo
	exit 1
fi

exec "${GODOT_ROOT}/platform/frt/scripts/basic_compile.sh"
